# Exchange Configuration
EXCHANGE=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
SANDBOX=true

# Trading Pairs (comma-separated)
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,DOGE/USDT,PEPE/USDT,FLOKI/USDT,BONK/USDT

# Risk Management
MAX_RISK_PER_TRADE=0.02  # 2% of balance per trade
MAX_DAILY_LOSS=0.05      # 5% max daily loss limit
MIN_CONFIDENCE=0.6       # Minimum 60% confidence to execute trade

# AI Model Configuration
LEARNING_RATE=0.001
RETRAIN_INTERVAL=50      # Retrain after every 50 new data points
MODEL_SAVE_INTERVAL=100  # Save model every 100 trades
